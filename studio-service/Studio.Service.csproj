<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeFrameworkVersion>10.0.13</RuntimeFrameworkVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>Studio.Service</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Compat.cs.txt" LogicalName="Studio.Compat.cs" WithCulture="false" />
    <EmbeddedResource Include="GridCompat.cs.txt" LogicalName="Studio.GridCompat.cs" WithCulture="false" />
    <EmbeddedResource Include="ControlDefaults.cs" LogicalName="Studio.ControlDefaults.cs" WithCulture="false" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.0.0" />
    <PackageDownload Include="Microsoft.WindowsDesktop.App.Ref" Version="[10.0.0]" />
  </ItemGroup>
  <Target Name="CopyWindowsReferences" AfterTargets="Build;Publish">
    <ItemGroup>
      <WindowsReference Include="$(NuGetPackageRoot)/microsoft.windowsdesktop.app.ref/10.0.0/ref/net10.0/*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(WindowsReference)" DestinationFolder="$(OutputPath)winforms-ref" />
    <Copy SourceFiles="@(WindowsReference)" DestinationFolder="$(PublishDir)winforms-ref" Condition="'$(PublishDir)' != ''" />
    <Copy SourceFiles="$(NuGetPackageRoot)/microsoft.windowsdesktop.app.ref/10.0.0/data/FrameworkList.xml" DestinationFolder="$(OutputPath)winforms-ref" />
    <Copy SourceFiles="$(NuGetPackageRoot)/microsoft.windowsdesktop.app.ref/10.0.0/data/FrameworkList.xml" DestinationFolder="$(PublishDir)winforms-ref" Condition="'$(PublishDir)' != ''" />
    <Copy SourceFiles="$(NuGetPackageRoot)/microsoft.windowsdesktop.app.ref/10.0.0/LICENSE" DestinationFolder="$(PublishDir)winforms-ref" Condition="'$(PublishDir)' != ''" />
    <Copy SourceFiles="$(NuGetPackageRoot)/microsoft.codeanalysis.csharp.features/5.0.0/ThirdPartyNotices.rtf" DestinationFolder="$(PublishDir)" Condition="'$(PublishDir)' != ''" />
  </Target>
</Project>
